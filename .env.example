# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.

# --- Contact form (Web3Forms) -------------------------------------------------
# Create a free account at https://web3forms.com, enter the inbox that should
# receive inquiries (secretariat@obpgh.com), and paste the access key
# it gives you below. Without this, the contact form shows an error instead of
# silently discarding messages.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Canonical site URL ------------------------------------------------------
# Used for sitemap.xml, robots.txt, and social share previews. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://obpgh.com
